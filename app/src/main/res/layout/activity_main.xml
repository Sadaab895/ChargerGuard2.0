<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0D0D0D">

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ ChargerGuard"
        android:textSize="32sp"
        android:textColor="#00FF88"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Battery ko safe rakho"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="40dp"/>

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A2E"
        android:padding="20dp"
        android:orientation="vertical"
        android:layout_marginBottom="32dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Accessibility Service enable karo pehle."
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:lineSpacingExtra="6dp"/>
    </LinearLayout>

    <!-- Step 1: Enable Accessibility -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Step 1: Accessibility Service Enable karo"
        android:textSize="13sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnEnableAccessibility"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Accessibility Settings Kholo"
        android:textColor="#000000"
        android:backgroundTint="#00FF88"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- Step 2: Start App -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Step 2: App Start karo"
        android:textSize="13sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🚀 ChargerGuard Start Karo"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1A6B3C"
        android:textStyle="bold"/>

    <!-- Info Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="App start karne ke baad charger lagao.\nWiFi off aur apps clear ho jayenge automatically."
        android:textSize="12sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:lineSpacingExtra="4dp"/>

</LinearLayout>
